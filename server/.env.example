PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password for the demo supplier accounts created by the seed scripts
# (npm run seed:demo / npm run seed:supplier). At least 8 characters. Never commit it.
SEED_DEMO_PASSWORD=

# Hugging Face inference (AI assistant, semantic search, embeddings).
# The marketplace still runs without these; AI features report as unavailable.
HF_TOKEN=
HF_CHAT_MODEL=
HF_EMBEDDING_MODEL=
# Optional: vector length the embedding model returns (e.g. 384 for
# sentence-transformers/all-MiniLM-L6-v2). Responses of any other length are rejected.
HF_EMBEDDING_DIM=

# Comma-separated list of allowed frontend origins, e.g. https://vastra.vercel.app
# Leave empty in development to allow any origin.
CLIENT_ORIGIN=

# Set to 1 when running behind a single reverse proxy (Render, Railway, Nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=
