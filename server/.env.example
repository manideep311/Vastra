PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Password for the demo supplier accounts created by the seed scripts
# (npm run seed:demo / npm run seed:supplier). At least 8 characters. Never commit it.
SEED_DEMO_PASSWORD=

# Embeddings (AI search, similar products, recommendations, assistant retrieval).
# "local" (default) runs sentence-transformers/all-MiniLM-L6-v2 inside the server:
# free, no API key. Run `npm run model:download` once (and in the deploy build step).
# "huggingface" calls the hosted Hugging Face API instead (needs HF_TOKEN and
# HF_EMBEDDING_MODEL). After switching, run `npm run backfill:embeddings -- --all`.
EMBEDDING_PROVIDER=local
# Optional: expected vector length (384 for all-MiniLM-L6-v2). Other lengths are rejected.
EMBEDDING_DIM=

# Chat model for the assistant and supplier suggestions. Defaults to Groq's free tier
# (free key at https://console.groq.com). Set LLM_BASE_URL only to use another
# OpenAI-compatible API. Set LLM_MODEL to a model Groq currently serves (models get
# renamed and retired). Without a key the assistant answers with keyword matches only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Only for EMBEDDING_PROVIDER=huggingface (hosted embeddings instead of the local model).
HF_TOKEN=
HF_EMBEDDING_MODEL=

# Comma-separated list of allowed frontend origins, e.g. https://vastra-311.vercel.app
# Required when NODE_ENV=production (the server refuses to start without it).
# Leave empty in development to allow any origin.
CLIENT_ORIGIN=

# Set to 1 when running behind a single reverse proxy (Render, Railway, Nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=
